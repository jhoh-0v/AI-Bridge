{
  "manifest_version": 3,
  "name": "AI Bridge · ChatGPT 실습 코치",
  "version": "1.0.0",
  "description": "실제 ChatGPT 화면에서 엑셀 요청·검증·수정을 연습하고, 도움 없이 새 과제에 도전하세요.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "action": {"default_title": "AI Bridge 실습 코치 열기", "default_icon": {"16":"icons/16.png","32":"icons/32.png"}},
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "background": {"service_worker":"worker.js", "type":"module"},
  "side_panel": {"default_path":"panel.html"},
  "content_scripts": [
    {"matches":["https://chatgpt.com/*"],"js":["content.js"],"run_at":"document_idle"},
    {"matches":["https://ai-bridge-lab-bd5373.mystic-grape-2563.chatgpt.site/*"],"js":["site-bridge.js"],"run_at":"document_idle"}
  ],
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'self'"}
}
